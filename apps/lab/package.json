{
  "name": "sc-item-render",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Renders Star Citizen inventory items the way the game does, from the local install",
  "scripts": {
    "dev": "vite dev --port 1420",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
