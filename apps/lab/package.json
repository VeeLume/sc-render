    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "bits-ui": "^2.16.5",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "shadcn-svelte": "^1.2.5",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.0",
    "@types/three": "^0.186.0",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.2",
